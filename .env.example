# ─────────────────────────────────────────────
# Supabase
# Obtenlas en: supabase.com → Settings → API
# NUNCA uses la service_role_key en el frontend
# ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ─────────────────────────────────────────────
# EAS / Expo
# Obtenla en: expo.dev → tu proyecto → Settings
# ─────────────────────────────────────────────
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID_HERE

# ─────────────────────────────────────────────
# Stripe Demo Backend
# Para Expo en dispositivo real usa la URL pública
# de tu Codespace/túnel en lugar de localhost
# ─────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_BACKEND=https://silver-acorn-5xj7qgqjw6727vrw-3000.app.github.dev/

# Stripe Keys (para el backend local)
# Obtenlas en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
