# Stripe — clave pública (publishable key) de tu cuenta Stripe
# Empieza con pk_test_ para entorno de pruebas o pk_live_ para producción
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# URL de tu backend que expone el endpoint POST /create-payment-intent
# El backend debe usar stripe.paymentIntents.create() — NO stripe.charges.create()
# Usar charges.create() provoca HTTP 410 (Gone) porque ese endpoint está deprecado
EXPO_PUBLIC_BACKEND_URL=https://your-backend.com
